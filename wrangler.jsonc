// Deployed only by the GitHub workflows (see `pnpm release`); never run `wrangler deploy` by hand.
{
	"$schema": "./node_modules/wrangler/config-schema.json",
	"name": "pylon-stats",
	"account_id": "f8bdca2bb163fea5cdabf6348bef9049",
	"main": ".svelte-kit/cloudflare/_worker.js",
	"compatibility_date": "2026-10-01",
	"compatibility_flags": ["nodejs_als"],
	"assets": { "binding": "ASSETS", "directory": ".svelte-kit/cloudflare" },
	"routes": [{ "pattern": "pylon.tpetrov.dev", "custom_domain": true }],
	// Production is only pylon.tpetrov.dev. workers.dev serves just the PR previews (the deploy-preview
	// label), which upload versions under pr-<number> aliases.
	"workers_dev": false,
	"preview_urls": true
}
